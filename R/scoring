crps_norm <- function(y, mu, sigma) {
  z <- (y - mu) / sigma
  sigma * (z * (2 * pnorm(z) - 1) + 2 * dnorm(z) - 1 / sqrt(pi))
}

## CRPS via the sorted-sample identity:
## E|X-X'| = 2/n^2 * sum (2i - n - 1) x_(i).
crps_emp_one <- function(s, y) {
  n <- length(s); ss <- sort(s)
  term1 <- mean(abs(s - y))
  term2 <- (2 / n^2) * sum((2 * seq_len(n) - n - 1) * ss)
  term1 - 0.5 * term2
}
qscore <- function(y, q, tau) ifelse(y >= q, tau * (y - q), (1 - tau) * (q - y))

## Total-reserve scores
## z = (truth - reserve) / SE, z > 0 leads to under-reserving.
## pit_model: share of the model's own predictive
## distribution below the truth (simulations, or Mack's Cornish-Fisher quantiles).
score_total <- function(reserve, se, truth, sims = NULL, pitfun = NULL) {
  z <- if (isTRUE(se > 0)) (truth - reserve) / se else NA_real_
  out <- list(error = reserve - truth, pct_error = 100 * (reserve - truth) / truth,
              se = se, cv = se / reserve, z = z, pit_normal = pnorm(z),
              pit_model = NA_real_, in95 = NA, crps = NA_real_,
              qs75 = NA_real_, qs95 = NA_real_)
  if (!is.null(sims)) {
    Q <- quantile(sims, c(0.025, 0.75, 0.95, 0.975), names = FALSE)
    out$pit_model <- mean(sims <= truth)
    out$in95 <- truth >= Q[1] & truth <= Q[4]
    out$crps <- crps_emp_one(sims, truth)
    out$qs75 <- qscore(truth, Q[2], 0.75); out$qs95 <- qscore(truth, Q[3], 0.95)
  } else if (!is.na(z)) {
    out$in95 <- abs(z) <= qnorm(0.975)
    out$crps <- crps_norm(truth, reserve, se)
    out$qs75 <- qscore(truth, qnorm(0.75, reserve, se), 0.75)
    out$qs95 <- qscore(truth, qnorm(0.95, reserve, se), 0.95)
  }
  if (!is.null(pitfun)) out$pit_model <- pitfun(truth)
  out
}

## One estimate = total, its SE, by-origin reserves and SEs, simulations.
est <- function(total, se = NA_real_, o = NULL, se_o = NULL, sims = NULL, pitfun = NULL)
  list(total = total, se = se, o = o, se_o = se_o, sims = sims, pitfun = pitfun)