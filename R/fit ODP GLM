############################# ccODP RESERVING MODEL ############################
# R/fit ODP GLM -- functions only, no top-level code.
#
# NOTE: this file has no .R extension, so analysis/00_setup.R does not source
# it; scripts that need fit_odp_glm() source it themselves after the setup.


#' Cross-classified over-dispersed Poisson (ccODP) model on a claims triangle
#'
#' Paper C (Gabrielli, Richman & Wuthrich 2020), Section 2 / thesis Section
#' 4.1: the incremental payments Y_ij of the upper triangle are independent
#' with
#'   E[Y_ij] = mu_ij = exp(c + alpha_i + beta_j),   Var(Y_ij) = phi * mu_ij,
#' identified by alpha_1 = beta_1 = 0 (their eq. (3); development period 1
#' here is their j = 0). The parameters are the (quasi-)Poisson MLE, fitted by
#' IWLS, which minimises the Poisson deviance (4); the predicted lower
#' triangle then sums to the chain-ladder reserve. c, alpha and beta are the
#' starting point of the bCCNN network (R/nn_models.R).
#'
#' @param triangle incremental claims triangle in any form prepare_triangle()
#'   reads (matrix, triangle.csv-style data.frame, long data). A full n x n
#'   square (triangle.csv, triangle_sets()$full) is cut to its upper triangle;
#'   a triangle with NA below the latest diagonal is used as it is.
#' @param cum TRUE if `triangle` is cumulative (default FALSE: incremental).
#' @param scale the payments are divided by scale before fitting (e.g. 1e6 to
#'   fit in millions, as Paper C fits in 1'000 CHF). Every output below (mu,
#'   reserves, deviance, phi) is in these units; c is shifted by -log(scale),
#'   alpha and beta do not change.
#' @param phi which dispersion estimate to return as $phi: "deviance" (Paper
#'   C eq. (5)) or "pearson".
#' @param cells optional n x n logical mask of the observed cells to fit on
#'   (e.g. the training cells of a rolling-origin partition); default all
#'   observed cells. Every accident and development period needs a cell.
#' @param mask_future,... passed to prepare_triangle().
#' @return a list:
#'   c, alpha, beta   intercept and effects (alpha[1] = beta[1] = 0), length n;
#'   mu               n x n means: fitted (upper) and predicted (lower);
#'   y                observed upper triangle in units of scale (lower NA);
#'   cells            the cells fitted on;
#'   by_origin, total reserves in the shape of R/classical_models.R's wrappers;
#'   reserve_o, reserve  predicted outstanding payments by origin and in total;
#'   deviance         in-sample Poisson deviance (4) on `cells`, phi = 1;
#'   phi, phi_deviance, phi_pearson  dispersion estimates, both
#'                    (statistic) / (n_obs - n_par), n_par = 2n - 1 (= I + J);
#'   zero_origin, zero_dev  logical, periods whose fitted payments sum to 0:
#'                    their MLE is -Inf, which glm reports as a large negative
#'                    "converged" value (about -30), so their means are ~0;
#'   n_obs, n_par, scale, converged, model (the glm object).
fit_odp_glm <- function(triangle, cum = FALSE, scale = 1,
                        phi = c("deviance", "pearson"), cells = NULL,
                        mask_future = NULL, ...) {
  phi <- match.arg(phi)
  tri <- prepare_triangle(triangle, cum = cum, mask_future = mask_future, ...)
  inc <- ChainLadder::cum2incr(tri)
  y <- matrix(as.numeric(inc), nrow(inc), ncol(inc))
  n <- nrow(y)
  if (ncol(y) != n) {
    stop("fit_odp_glm(): needs a square triangle (as many development as ",
         "accident periods), got ", n, " x ", ncol(y), call. = FALSE)
  }
  y <- y / scale
  obs <- !fut_mask(n)
  if (anyNA(y[obs])) {
    stop("fit_odp_glm(): the upper triangle has NA cells", call. = FALSE)
  }
  if (any(y[obs] < 0)) {
    stop("fit_odp_glm(): negative incremental payments; the ODP model ",
         "needs Y_ij >= 0", call. = FALSE)
  }
  y[!obs] <- NA
  if (is.null(cells)) cells <- obs
  cells <- unname(as.matrix(cells))
  if (!identical(dim(cells), c(n, n)) || !is.logical(cells) || anyNA(cells) ||
        any(cells & !obs)) {
    stop("fit_odp_glm(): cells must be an n x n logical mask of observed cells",
         call. = FALSE)
  }
  if (any(rowSums(cells) == 0) || any(colSums(cells) == 0)) {
    stop("fit_odp_glm(): every accident and development period needs at ",
         "least one cell to fit on", call. = FALSE)
  }
  paid <- ifelse(cells, y, 0)
  zero_origin <- rowSums(paid) == 0
  zero_dev <- colSums(paid) == 0
  if (any(zero_origin) || any(zero_dev)) {
    where <- c(if (any(zero_origin)) paste("accident period(s)",
                                           paste(which(zero_origin), collapse = ", ")),
               if (any(zero_dev)) paste("development period(s)",
                                        paste(which(zero_dev), collapse = ", ")))
    warning("fit_odp_glm(): no payments in ", paste(where, collapse = " and "),
            ": their effects are -Inf (fitted means ~0)", call. = FALSE)
  }

  dat <- data.frame(y = y[cells],
                    origin = factor(row(y)[cells], levels = seq_len(n)),
                    dev = factor(col(y)[cells], levels = seq_len(n)))
  # treatment contrasts give exactly Paper C's identification (3):
  # intercept c, alpha_1 = beta_1 = 0
  fit <- stats::glm(y ~ origin + dev, family = stats::quasipoisson(link = "log"),
                    data = dat,
                    control = stats::glm.control(epsilon = 1e-12, maxit = 100))
  if (!isTRUE(fit$converged)) {
    warning("fit_odp_glm(): the GLM did not converge", call. = FALSE)
  }
  b <- stats::coef(fit)
  if (anyNA(b)) {
    stop("fit_odp_glm(): some parameters are not identifiable (the fitted ",
         "cells do not connect all accident and development periods)",
         call. = FALSE)
  }
  c0    <- unname(b["(Intercept)"])
  alpha <- c(0, unname(b[paste0("origin", 2:n)]))
  beta  <- c(0, unname(b[paste0("dev", 2:n)]))
  mu <- exp(c0 + outer(alpha, beta, "+"))
  dimnames(mu) <- dimnames(y) <- list(origin = seq_len(n), dev = seq_len(n))

  n_obs <- sum(cells)
  n_par <- 2L * n - 1L
  deviance <- poisson_deviance(ifelse(cells, y, NA), mu)
  phi_deviance <- deviance / (n_obs - n_par)                      # eq. (5)
  phi_pearson  <- sum((y[cells] - mu[cells])^2 / mu[cells]) / (n_obs - n_par)

  by_origin <- reserve_by_origin(y, mu)
  list(c = c0, alpha = alpha, beta = beta, mu = mu, y = y, cells = cells,
       by_origin = by_origin, total = reserve_totals(by_origin),
       reserve_o = by_origin$ibnr, reserve = sum(by_origin$ibnr),
       deviance = deviance,
       phi = if (phi == "deviance") phi_deviance else phi_pearson,
       phi_deviance = phi_deviance, phi_pearson = phi_pearson,
       zero_origin = zero_origin, zero_dev = zero_dev,
       n_obs = n_obs, n_par = n_par, scale = scale,
       converged = isTRUE(fit$converged), model = fit)
}
