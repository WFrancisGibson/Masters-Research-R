source(here::here("analysis", "00_setup.R"))


# loads the 20 x 20 annual incremental claims triangle
tri_mack <- prepare_triangle(
                             fread(
                                   file.path(
                                             paths$raw,
                                             "claim-simulation-annual",
                                             "triangle.csv")))
cl   <- fit_chainladder(tri_mack, cum = FALSE)
mack_model <- MackChainLadder(tri_mack, est.sigma = "Mack")



mack_model$total       # reserve, SE, CV
mack_model$by_origin   # by accident quarter
s <- summary(mack_model)
save_reserve_tables(list(by_origin = s$ByOrigin,
                         total = unlist(s$Totals)), "mack_raw")


save_plot("MackCL Development Pattern.png", plot(mack_model))
save_plot("MackCL Triangle.png", plot(tri_mack))
save_plot("MackCL development by origin period.png",
          plot(mack_model, lattice = TRUE))

# Save the prepared triangle to an interim CSV file
fwrite(as.data.table(tri_mack, keep.rownames = "origin"),
       file.path(paths$interim, "tri_mack.csv"))


