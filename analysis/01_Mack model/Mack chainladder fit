source(here::here("analysis", "00_setup.R"))


# The 20 x 20 annual incremental triangle observed at the valuation date
# (year 20), built from the simulated payments with development years 1..20
# only, as for the bCCNN (analysis/03). triangle.csv is not used: it folds the
# payments after development year 20 into year 20, which for accident year 1
# is an observed cell, so it holds payments made after the valuation date.
raw_dir <- file.path(paths$raw, cfg$data$annual_dir)
transactions <- fread(file.path(raw_dir, "transactions.csv"),
                      select = c("claim_no", "occurrence_period",
                                 "payment_period", "payment_inflated"))
sets <- triangle_sets(transactions, n_dev = cfg$data$n_dev)

# Mack's chain ladder on the cumulative triangle (the input is incremental)
mack <- fit_mack(sets$upper, cum = FALSE, est.sigma = "Mack")
mack_model <- mack$model
tri_mack <- mack_model$Triangle                # cumulative observed triangle

# with volume-weighted factors, Mack's reserves are the chain-ladder reserves
cl <- fit_chainladder(sets$upper, cum = FALSE)
stopifnot(isTRUE(all.equal(mack$total[["ibnr"]], cl$total[["ibnr"]])))

# back-test: true reserves to development year 20 and the bias; the tail
# (payments after development year 20) is reported apart
mack <- add_truth(mack, sets)
mack$total       # latest, ultimate, ibnr (reserve), se, cv, true, bias, tail
mack$by_origin   # by accident year
save_reserve_tables(mack, "mack_raw")


save_plot("MackCL Development Pattern.png", plot(mack_model))
save_plot("MackCL Triangle.png", plot(tri_mack))
save_plot("MackCL development by origin period.png",
          plot(mack_model, lattice = TRUE))

# Save the prepared triangle to an interim CSV file
fwrite(as.data.table(tri_mack, keep.rownames = "origin"),
       file.path(paths$interim, "tri_mack.csv"))
