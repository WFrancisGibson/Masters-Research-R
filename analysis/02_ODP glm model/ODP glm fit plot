source(here::here("analysis", "00_setup.R"))


# The 20 x 20 annual incremental triangle observed at the valuation date
# (year 20), built from the simulated payments with development years 1..20
# only, as for the bCCNN (analysis/03). triangle.csv is not used: it folds the
# payments after development year 20 into year 20, which for accident year 1
# is an observed cell, so it holds payments made after the valuation date.
raw_dir <- file.path(paths$raw, cfg$data$annual_dir)
transactions <- fread(file.path(raw_dir, "transactions.csv"),
                      select = c("claim_no", "occurrence_period",
                                 "payment_period", "payment_inflated"))
sets <- triangle_sets(transactions, n_dev = cfg$data$n_dev)
tri_glm_odp <- prepare_triangle(sets$upper, cum = FALSE)   # cumulative

# over-dispersed Poisson GLM (glmReserve), standard errors by the formula
# and by the bootstrap
odp      <- fit_glm_reserve(sets$upper, cum = FALSE)
# the bootstrap's tweedie::rtweedie() warns "non-integer x" in an unused
# check; its draws, phi * rpois(mu / phi), are correct
odp_boot <- suppressWarnings(fit_glm_reserve(sets$upper, cum = FALSE,
                                             mse.method = "bootstrap"))

# the ODP GLM reserves are the chain-ladder reserves
cl <- fit_chainladder(sets$upper, cum = FALSE)
stopifnot(isTRUE(all.equal(odp$total[["ibnr"]], cl$total[["ibnr"]])))

# back-test: true reserves to development year 20 and the bias; the tail
# (payments after development year 20) is reported apart
odp      <- add_truth(odp, sets)
odp_boot <- add_truth(odp_boot, sets)
odp$total        # latest, ultimate, ibnr (reserve), se, cv, true, bias, tail
odp_boot$total
odp$by_origin    # by accident year
save_reserve_tables(odp, "odp_raw")
save_reserve_tables(odp_boot, "odp_boot_raw")
fwrite(data.table(total = odp_boot$simulations$total),
       file.path(paths$tables, "odp_boot_raw_simulations.csv"))


save_plot("GLM reserves triangle.png", plot(tri_glm_odp))
# plot.glmReserve: which = 2 the completed triangle, 3 the bootstrap
# reserves, 4 residuals against fitted values
save_plot("GLM ODP fit.png", plot(odp$model, which = 2))
save_plot("GLM ODP fit lattice.png", plot(odp$model, which = 2, lattice = TRUE))
save_plot("GLM ODP residuals.png", plot(odp$model, which = 4))
save_plot("GLM ODP bootstrap reserves.png", plot(odp_boot$model, which = 3),
          width = 1200, height = 700)
